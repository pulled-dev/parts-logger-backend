# Local settings for scripts/exceptions_report.py (copy to .env).
# No secrets here: the password lives in BREAKERPRO_PASSWORD_FILE.
BREAKERPRO_SERVER=.\SQLEXPRESS
BREAKERPRO_DATABASE=BreakerPro
BREAKERPRO_USER=breakerpro_readonly
BREAKERPRO_PASSWORD_FILE=C:\Users\ACER\.secrets\breakerpro-readonly\password.txt
BREAKERPRO_ODBC_DRIVER=ODBC Driver 17 for SQL Server

# Exceptions report thresholds
EXC_UNPICKED_HOURS=24
EXC_LOW_PRICE_GBP=8
EXC_AGED_DAYS=180
EXC_QUERY_TIMEOUT_S=5
EXC_DELETION_DAYS=7
EXC_DELETION_CHECK_GBP=30
EXC_MOBILE_REMOVAL_CUTOVER=2026-10-28
