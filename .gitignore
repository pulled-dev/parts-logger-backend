data/
__pycache__/

# Local tool state
.claude/

# Local SQLite DB (live data is on the Railway volume)
vehicles.db

# Vehicle import drop folders: BreakerPro exports, run logs and generated
# sheets. Keep only the README in each so the folder's purpose is documented.
vehicle-imports/inbox/*
!vehicle-imports/inbox/_README.txt
vehicle-imports/done/*
!vehicle-imports/done/_README.txt
vehicle-imports/logs/*
!vehicle-imports/logs/_README.txt
vehicle-imports/stock-sheets/

# Local settings and generated reports (BreakerPro exceptions etc.)
.env
reports/

# Playwright MCP snapshots/console logs
.playwright-mcp/

# Local analytics store and generated review queue
analytics/analytics.db
analytics/review_queue.csv

# Pick lists and other generated outputs (no customer data, but local only)
outputs/

# Google Business Profile API secrets. These live in %LOCALAPPDATA%\PulledApart
# and must never be committed; ignored here too in case a copy lands in the repo.
gbp-oauth-client.json
gbp-token.json
gbp-api.json
